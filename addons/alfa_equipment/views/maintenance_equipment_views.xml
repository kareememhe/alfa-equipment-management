<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds "Calibration" and "QR Code" tabs to Odoo's existing equipment form -->
    <record id="maintenance_equipment_form_alfa" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.alfa</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Calibration" name="calibration">
                    <group>
                        <group>
                            <field name="calibration_required"/>
                            <field name="calibration_interval"
                                   invisible="not calibration_required"/>
                            <field name="last_calibration_date"
                                   invisible="not calibration_required"/>
                        </group>
                        <group>
                            <field name="next_calibration_date"
                                   invisible="not calibration_required"/>
                            <field name="calibration_status" widget="badge"
                                   decoration-success="calibration_status == 'ok'"
                                   decoration-warning="calibration_status == 'due_soon'"
                                   decoration-danger="calibration_status in ('overdue', 'never')"
                                   invisible="not calibration_required"/>
                        </group>
                    </group>
                </page>
                <page string="QR Code" name="qr_code">
                    <group>
                        <group>
                            <field name="qr_image" widget="image" readonly="1" nolabel="1"
                                   options="{'size': [200, 200]}"/>
                        </group>
                        <group>
                            <field name="qr_url" widget="url" readonly="1"/>
                            <div colspan="2" class="text-muted">Staff scan this code to report a fault without logging in. Print a label from the Print menu.</div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
